#!/bin/bash
source /root/.bashrc

STATUS=0

if [ ! -d ".doravel" ]; then
    STATUS=1
    echo "❌ Directory .doravel not found"
fi

if [ ! -d "vendor" ]; then
    STATUS=1
    echo "❌ Directory vendor not found"
fi

if [ ! -d "node_modules" ]; then
    STATUS=1
    echo "❌ Directory node_modules not found"
fi

if [ ! -d ".doravel/nginx/http.d" ]; then
    STATUS=1
    echo "❌ Directory .doravel/nginx/http.d not found"
fi

if [ ! -d ".doravel/nginx/https.d" ]; then
    STATUS=1
    echo "❌ Directory .doravel/nginx/https.d not found"
fi

for ENVIRONMENT in $(get_env_names); do
    DOCKERCOMPOSE_NAME="docker-compose"
    DOCKERFILE_PATH="Dockerfile"
    ENV_PATH=".env"

    if [ "$ENVIRONMENT" != "local" ]; then
        DOCKERCOMPOSE_NAME="docker-compose.$ENVIRONMENT"
        DOCKERFILE_PATH="Dockerfile.$ENVIRONMENT"
        ENV_PATH=".env.$ENVIRONMENT"
    fi

    DOCKERCOMPOSE_PATH=$(find "$APP_PATH" -maxdepth 1 -name "$DOCKERCOMPOSE_NAME.y*ml" | head -n 1)

    if [ -z "$DOCKERCOMPOSE_PATH" ]; then
        STATUS=1
        echo "❌ File $DOCKERCOMPOSE_NAME.yaml not found"
    fi

    if [ ! -f "$ENV_PATH" ]; then
        STATUS=1
        echo "❌ File $ENV_PATH not found"
    fi

    if [ ! -f "$DOCKERFILE_PATH" ]; then
        STATUS=1
        echo "❌ File $DOCKERFILE_PATH not found"
    fi

    if ! grep -qE "APP_ENV(\s+)?=(\s+)?$ENVIRONMENT" $ENV_PATH; then
        STATUS=1
        echo "❌ APP_ENV=$ENVIRONMENT not found in $ENV_PATH"
    fi

    if [ ! -f ".doravel/cron/$ENVIRONMENT" ]; then
        STATUS=1
        echo "❌ File .doravel/cron/$ENVIRONMENT not found"
    fi

    if [ ! -f ".doravel/php/$ENVIRONMENT.ini" ]; then
        STATUS=1
        echo "❌ File .doravel/php/$ENVIRONMENT.ini not found"
    fi

    if [ ! -d ".doravel/php/$ENVIRONMENT.d" ]; then
        STATUS=1
        echo "❌ Directory .doravel/php/$ENVIRONMENT.d not found"
    fi

    if [ ! -f ".doravel/supervisor/$ENVIRONMENT.conf" ]; then
        STATUS=1
        echo "❌ File .doravel/supervisor/$ENVIRONMENT.conf not found"
    fi

    if [ ! -d ".doravel/supervisor/$ENVIRONMENT.d" ]; then
        STATUS=1
        echo "❌ Directory .doravel/supervisor/$ENVIRONMENT.d not found"
    fi

    if [ ! -f ".doravel/nginx/$ENVIRONMENT.conf" ]; then
        STATUS=1
        echo "❌ File .doravel/nginx/$ENVIRONMENT.conf not found"
    fi
done

