#!/bin/bash

onSigTerm() {
    if [ ! -z "$child" ]; then
        kill -SIGTERM $child 2>/dev/null
    else
        exit 0
    fi
}

onSigQuit() {
    if [ ! -z "$child" ]; then
        kill -SIGQUIT $child 2>/dev/null
    else
        exit 0
    fi
}

onSigKill() {
    if [ ! -z "$child" ]; then
        kill -SIGKILL $child 2>/dev/null
    else
        exit 0
    fi
}

trap onSigTerm SIGTERM
trap onSigQuit SIGQUIT
trap onSigKill SIGKILL

APP_PATH=${APP_PATH:-"/var/www"}

if [ ! -f /usr/local/bin/php-cli ]; then
    gum log --time rfc822 --level fatal "No has instalado PHP"
    # TODO - aqui debe hacer informacion de como usar el comando builder para instalar PHP
    exit 1
fi

if [[ "$@" =~ "artisan" ]] && [ "$PWD" == "$APP_PATH" ]; then
    if [ ! -f /usr/local/bin/composer ]; then
        gum log --time rfc822 --level fatal "No has instalado Composer"
        # TODO - aqui debe hacer informacion de como usar el comando builder para instalar Composer
        exit 1
    fi

    if [ ! -d "$APP_PATH/vendor" ]; then
        gum log --time rfc822 --level fatal "No has instalado las dependencias de Composer"
        exit 1
    fi
fi

ENV_FILE=$(get_env_file $APP_ENV)

if [ -f $ENV_FILE ]; then
    source $ENV_FILE
else
    echo "No se ha encontrado el archivo de configuración $ENV_FILE"
    exit 1
fi

# PHP ENVIROMENT
PHP_UPLOAD_MAX_FILESIZE=${PHP_UPLOAD_MAX_FILESIZE:-1G}
PHP_MAX_EXECUTION_TIME=${PHP_MAX_EXECUTION_TIME:-60}
PHP_OPCACHE_ENABLED=${PHP_OPCACHE_ENABLED:-false}
PHP_POST_MAX_SIZE=${PHP_POST_MAX_SIZE:-0}
PHP_MEMORY_LIMIT=${PHP_MEMORY_LIMIT:-"-1"}

# FILE
PHP_INI_FILE="$APP_PATH/.doravel/php/$APP_ENV.ini"

if [ ! -f $PHP_INI_FILE ]; then
    PHP_INI_FILE="/etc/php/php.ini"
fi

OPCACHE_ENABLE=$(is_true $PHP_OPCACHE_ENABLED && echo 1 || echo 0)

/usr/local/bin/php-cli \
    -c "$PHP_INI_FILE" \
    -d variables_order=EGPCS \
    -d "upload_max_filesize=$PHP_UPLOAD_MAX_FILESIZE" \
    -d "max_execution_time=$PHP_MAX_EXECUTION_TIME" \
    -d "post_max_size=$PHP_POST_MAX_SIZE" \
    -d "memory_limit=$PHP_MEMORY_LIMIT" \
    -d "opcache.enable_cli=$OPCACHE_ENABLE" \
    -d "opcache.enable=$OPCACHE_ENABLE" \
    $@ &
child=$!
wait "$child"