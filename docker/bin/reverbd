#!/bin/bash
set -eu

onSigTerm() {
    if [ ! -z "$child" ]; then
        kill -SIGTERM $child 2>/dev/null
    else
        exit 0
    fi
}

onSigQuit() {
    if [ ! -z "$child" ]; then
        kill -SIGQUIT $child 2>/dev/null
    else
        exit 0
    fi
}

onSigKill() {
    if [ ! -z "$child" ]; then
        kill -SIGKILL $child 2>/dev/null
    else
        exit 0
    fi
}

trap onSigTerm SIGTERM
trap onSigQuit SIGQUIT
trap onSigKill SIGKILL

/usr/local/bin/artisan reverb:start $@ &
child=$!
wait "$child"