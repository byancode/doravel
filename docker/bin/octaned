#!/bin/bash

source /root/.bashrc

source $(get_env_file $APP_ENV)

echo $$ > /var/run/octaned.pid

cleanup() {
    rm -f /var/run/octaned.pid
    exit 0;
}

trap cleanup SIGTERM
trap cleanup SIGQUIT
trap cleanup EXIT

OCTANE_SERVER=${OCTANE_SERVER:-"swoole"}
OCTANE_SERVER_ARGS=${OCTANE_SERVER_ARGS:-""}

artisan octane:start --server=$OCTANE_SERVER $@ $OCTANE_SERVER_ARGS
