#!/bin/bash

source /root/.bashrc

source $(get_env_file $APP_ENV)

onSigTerm() {
    if [ ! -z "$child" ]; then
        kill -SIGTERM $child 2>/dev/null
    else
        exit 0
    fi
}

onSigQuit() {
    if [ ! -z "$child" ]; then
        kill -SIGQUIT $child 2>/dev/null
    else
        exit 0
    fi
}

onSigKill() {
    if [ ! -z "$child" ]; then
        kill -SIGKILL $child 2>/dev/null
    else
        exit 0
    fi
}

trap onSigTerm SIGTERM
trap onSigQuit SIGQUIT
trap onSigKill SIGKILL

OCTANE_SERVER=${OCTANE_SERVER:-"swoole"}
OCTANE_SERVER_OPTIONS=${OCTANE_SERVER_OPTIONS:-""}

artisan octane:start --server=$OCTANE_SERVER $@ $OCTANE_SERVER_OPTIONS &
child=$!
wait "$child"
